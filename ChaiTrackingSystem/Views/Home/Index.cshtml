@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <title>TrackMyChai</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">


    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Poppins', sans-serif;
        }

        body {
            background: #0f0f0f;
            color: white;
        }

        
        .navbar {
            background: rgba(0,0,0,0.6);
            backdrop-filter: blur(10px);
            padding: 15px 50px;
            border-bottom: 1px solid rgba(255,140,0,0.3);
        }

        .logo {
            display: flex;
            align-items: center;
            font-size: 22px;
            font-weight: 600;
        }

            .logo img {
                height: 55px;
                margin-right: 10px;
            }

        .highlight {
            color: #ff8c00;
        }

        .nav-links a {
            text-decoration: none;
            color: white;
            margin-left: 25px;
            font-weight: 500;
            position: relative;
        }

            .nav-links a:hover {
                color: #ff8c00;
            }

     
        .hero {
            height: 100vh;
            display: flex;
            align-items: center;
            padding: 60px;
            background: url('/Content/chai-bg.png') no-repeat center;
            background-size: cover;
            position: relative;
        }

            .hero::before {
                content: '';
                position: absolute;
                width: 100%;
                height: 100%;
                background: linear-gradient(to right, rgba(0,0,0,0.9), rgba(0,0,0,0.3));
                top: 0;
                left: 0;
            }

        .hero-left {
            position: relative;
            z-index: 2;
            max-width: 600px;
        }

        .hero h1 {
            font-size: 60px;
            font-weight: 700;
        }

        .hero span {
            color: #ff8c00;
        }

        .hero p {
            margin-top: 15px;
            font-size: 20px;
            color: #ccc;
        }

   
        .btn-start {
            margin-top: 25px;
            background: linear-gradient(45deg, #ff8c00, #ff5e00);
            border: none;
            padding: 14px 35px;
            border-radius: 40px;
            color: white;
            font-size: 18px;
            box-shadow: 0 10px 25px rgba(255,140,0,0.4);
            transition: 0.3s;
        }

            .btn-start:hover {
                transform: scale(1.05);
            }

       
     
        section {
            padding: 80px 20px;
            background: #111;
        }

        .feature-box {
            padding: 25px;
            border-radius: 15px;
            background: rgba(255,255,255,0.05);
            backdrop-filter: blur(10px);
            transition: 0.3s;
        }

            .feature-box:hover {
                transform: translateY(-10px);
            }


        .contact-box input,
        .contact-box textarea {
            background: rgba(255,255,255,0.05);
            color: white;
            border: none;
        }

   
        footer {
            background: black;
            padding: 20px;
            text-align: center;
        }

        @@media(max-width:768px) {

            .hero {
                padding: 20px;
                text-align: center;
                justify-content: center;
            }

                .hero h1 {
                    font-size: 32px;
                }

            .stats {
                position: static;
                margin-top: 30px;
                flex-direction: column;
                align-items: center;
            }

            .nav-links {
                display: none;
            }
        }
    </style>
</head>

<body>

    <nav class="navbar d-flex justify-content-between align-items-center">

        <div class="logo">
            <img src="~/Content/chai-logo.png" />
            <span>Track<span class="highlight">My</span>Chai</span>
        </div>

        <div class="nav-links">
            <a href="#about">Our Chai</a>
            <a href="#features">Features</a>
            <a href="#contact">About Us</a>
        </div>

    </nav>


    <div class="hero">

        <div class="hero-left">
            <h1>
                Track your chai journey <br>
                <span>with ease</span>
            </h1>

            <p>
                Never miss a sip — track, manage & enjoy your chai breaks ☕
            </p>

            <a href="/Account/Login" class="btn btn-start">
                Get Started
            </a>
        </div>

    </div>

    <div id="about" class="container text-center py-5">

        <h2>📖 About TrackMyChai</h2>

        <p class="mt-3">
            TrackMyChai is designed to help users manage and monitor their daily chai and coffee consumption.
            This application was created to bring a simple and smart way to track tea breaks in offices or daily life.
        </p>

        <p>
            Users can easily add requests, view their history, and analyze their consumption patterns.
            It helps improve productivity and keeps track of daily habits efficiently.
        </p>

        <p>
            <strong>How to use?</strong><br />
            1. Register/Login<br />
            2. Add your chai/coffee request<br />
            3. View dashboard & analytics<br />
            4. Export reports if needed
        </p>

    </div>
    <div id="features" class="container text-center py-5">

        <h2 class="mb-4">✨ Features</h2>

        <div class="row">

            <div class="col-md-4">
                <div class="p-4 shadow rounded bg-dark text-white">
                    ☕ <h5>Track Daily Chai</h5>
                    <p>Log your tea & coffee requests easily and track your daily consumption.</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="p-4 shadow rounded bg-dark text-white">
                    📊 <h5>Analytics Dashboard</h5>
                    <p>View insights like total cups, usage trends, and history.</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="p-4 shadow rounded bg-dark text-white">
                    📄 <h5>Export Reports</h5>
                    <p>Download your chai usage as PDF reports anytime.</p>
                </div>
            </div>

        </div>

    </div>

    <div id="contact" class="container text-center py-5">

        <h2>📞 Contact Us</h2>

        <p class="mt-3">
            Feel free to reach out for any queries or support.
        </p>

        <p>
            👩‍💻 <strong>Name:</strong> Hemangi Jangale <br />
            📞 <strong>Phone:</strong> 897596355 <br />
            📧 <strong>Email:</strong> hem@gmail.com
        </p>

    </div>

    <footer>
        ☕ TrackMyChai © 2026
    </footer>

</body>
</html>