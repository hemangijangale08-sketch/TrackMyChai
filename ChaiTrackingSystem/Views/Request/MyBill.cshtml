@model System.Data.DataTable

<h2>☕ My Billing Report</h2>
<a href="/Request/DownloadPDF" class="btn btn-danger mb-3">
    Download Bill PDF
</a>

<table class="table table-bordered">
    <tr>
        <th>Drink</th>
        <th>Cups</th>
        <th>Price</th>
        <th>Date</th>
    </tr>

    @if (Model != null && Model.Rows.Count > 0)
    {
        int total = 0;

        foreach (System.Data.DataRow row in Model.Rows)
        {
            total += Convert.ToInt32(row["Price"]);

            <tr>
                <td>@row["DrinkType"]</td>
                <td>@row["Cups"]</td>
                <td>₹ @row["Price"]</td>
                <td>@Convert.ToDateTime(row["CreatedAt"]).ToString("dd-MM-yyyy")</td>
            </tr>
        }

        <tr>
            <td colspan="2"><strong>Total</strong></td>
            <td colspan="2"><strong>₹ @total</strong></td>
        </tr>
    }
    else
    {
        <tr>
            <td colspan="4">No data found</td>
        </tr>
    }
</table>